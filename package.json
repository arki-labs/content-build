{
  "name": "@arki/content-build",
  "version": "0.2.1",
  "description": "Build-time content pipeline: content-collections config, preset collections (posts, legal pages, FAQs, changelog), GitHub-flavoured markdown compiler and the arki-content CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "content",
    "mdx",
    "markdown",
    "content-collections",
    "vite",
    "cli",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./config": {
      "types": "./dist/src/config.d.ts",
      "import": "./dist/src/config.js",
      "default": "./dist/src/config.js"
    },
    "./presets": {
      "types": "./dist/src/presets.d.ts",
      "import": "./dist/src/presets.js",
      "default": "./dist/src/presets.js"
    },
    "./vite": {
      "types": "./dist/src/vite.d.ts",
      "import": "./dist/src/vite.js",
      "default": "./dist/src/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.stories.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "llms.txt",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "arki-content": "./dist/src/cli.js"
  },
  "dependencies": {
    "@arki/contracts": "0.4.2",
    "@arki/log": "0.4.1",
    "@arki/schema": "0.3.1",
    "@code-hike/mdx": "0.9.0",
    "@content-collections/core": "0.15.3",
    "@content-collections/mdx": "0.2.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "peerDependencies": {
    "vite": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "runtimes": [
      "node",
      "bun",
      "deno"
    ]
  }
}
